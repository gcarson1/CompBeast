// Comp Beast — Pluggable Domain Model
//
// Design principle: the platform core (League/Team/Roster/User) and the
// scoring core (EventDefinition/ScoredEvent) never reference show-specific
// concepts directly. Everything that varies by show (Big Brother, Survivor,
// The Traitors, ...) lives behind Show/Season/Contestant/EventDefinition,
// which are just rows — adding a new show is a seed script, not a schema
// change or a code change to the scoring engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform: identity & multi-tenancy
// ---------------------------------------------------------------------------

model User {
  id              String  @id @default(cuid())
  // Opaque subject id from whichever auth provider is wired up (Clerk, Auth.js,
  // Supabase). Kept provider-neutral so swapping providers is a config change.
  authId          String  @unique
  email           String  @unique
  name            String?
  avatarUrl       String?
  handle          String? @unique
  /// Grants access to ingestion review, which rewrites scores across every
  /// league on a season — deliberately separate from per-league commissioner
  /// rights, which only ever affect one league.
  isPlatformAdmin Boolean @default(false)

  /// Master switch for every email this app sends. In-app alerts are
  /// unaffected — turning this off changes the channel, not the notification.
  emailNotifications Boolean            @default(true)
  /// Types this person has turned off individually. Storing the *off* set
  /// rather than the on set means a notification type added later arrives by
  /// default, instead of being silently undeliverable to everyone who
  /// registered before it existed.
  emailOptOut        NotificationType[]
  /// Opaque key behind the one-click unsubscribe link in every email. Written
  /// the first time we send to this person, which is why it is nullable —
  /// adding the column needed no backfill and no downtime.
  emailToken         String?            @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaguesOwned        League[]                 @relation("LeagueCommissioner")
  memberships         LeagueMember[]
  teams               Team[]
  auditedActions      ScoreAudit[]
  recordedEvents      ScoredEvent[]            @relation("EventRecorder")
  reviewedCandidates  IngestedEventCandidate[] @relation("CandidateReviewer")
  messages            LeagueMessage[]
  reactions           LeagueMessageReaction[]
  friendshipsSent     Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived Friendship[]             @relation("FriendshipAddressee")
  notifications       Notification[]           @relation("NotificationRecipient")
  notificationsCaused Notification[]           @relation("NotificationActor")
  careerRecords       CareerRecord[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Social graph
// ---------------------------------------------------------------------------

/// A friendship, stored as one directed row even though the relationship it
/// represents is symmetric.
///
/// The direction is kept because a *request* genuinely has a sender and a
/// receiver, and the UI has to tell "you asked them" apart from "they asked
/// you". Once ACCEPTED the direction stops meaning anything, so every read of
/// the friend list has to match on either column — see `friendIdsFor` in
/// src/server/social.ts, which is the single place that OR is written.
///
/// The unique constraint stops A asking B twice, but cannot stop A→B and B→A
/// existing at once. `sendFriendRequest` resolves that case by accepting the
/// pending row instead of creating a mirror of it: two people who each asked
/// are two people who both agreed.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  // "Requests waiting on me" and "my friends" are both addressee-side reads;
  // the unique above leads with requesterId so it cannot serve either.
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

/// BLOCKED is deliberately absent. Blocking needs its own semantics (hiding
/// content both ways, surviving an unfriend) and bolting it onto this enum
/// would make every friend query silently wrong until all of them were
/// updated. It belongs in its own model when it is actually built.
enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

/// One delivered alert for one person.
///
/// `title`/`body` are written at creation time rather than derived when the
/// list renders. That is the whole point: a notification has to survive the
/// thing it describes. "Your league was deleted" cannot join back to the
/// league, and a league renamed after the fact should still read the way it
/// read when it happened. Denormalising also keeps the list one query instead
/// of one join per row per type.
///
/// `data` is the escape hatch that keeps new notification kinds from needing a
/// migration — only the enum grows.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  /// In-app destination. Null for notifications with nowhere useful to go.
  href      String?
  /// The person who caused it, for the avatar. SetNull rather than Cascade —
  /// deleting an account should not silently retract the notifications its
  /// actions produced for other people.
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Type-specific context (leagueId, inviteCode, friendshipId, ...).
  data      Json?
  readAt    DateTime?
  /// When this went out as an email, or null for in-app only. Kept so a
  /// duplicate send is impossible to do by accident, and so "did they
  /// actually get told?" is answerable without the provider's dashboard.
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  // The header badge counts unread on every page load, which is the single
  // most frequent read in this table.
  @@index([userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  LEAGUE_INVITE
  LEAGUE_MEMBER_JOINED
  LEAGUE_DRAFT_STARTED
  /// Your turn. The only alert in the app that somebody else is blocked on.
  LEAGUE_DRAFT_PICK_DUE
  LEAGUE_DRAFT_COMPLETED
  LEAGUE_UPDATED
  LEAGUE_DELETED
}

// ---------------------------------------------------------------------------
// Show-agnostic program containers
// ---------------------------------------------------------------------------

/// A reality program franchise, e.g. "Big Brother", "Survivor", "The Traitors".
model Show {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  format    ShowFormat @default(TRADITIONAL_FANTASY_SPORT)
  /// Show-specific display vocabulary so the UI can say "Week"/"Episode"/"Round"
  /// and "Houseguest"/"Castaway" without any hardcoded per-show branching.
  lexicon   Json?
  createdAt DateTime   @default(now())

  seasons          Season[]
  eventDefinitions EventDefinition[]
  scoringRulesets  ScoringRuleset[]

  @@map("shows")
}

/// The kind of fantasy competition this show is played as. MVP only implements
/// TRADITIONAL_FANTASY_SPORT (fixed squads, weekly cycles, leaderboard).
enum ShowFormat {
  TRADITIONAL_FANTASY_SPORT
}

/// A single airing season/series of a Show, e.g. "Big Brother 27".
model Season {
  id        String       @id @default(cuid())
  showId    String
  show      Show         @relation(fields: [showId], references: [id], onDelete: Cascade)
  slug      String       @unique
  name      String
  year      Int
  /// Explicit rather than derived from dates: ingested seasons often arrive
  /// with no reliable air dates, but a finished season always has a winner.
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime     @default(now())

  contestants Contestant[]
  cycles      Cycle[]
  leagues     League[]
  candidates  IngestedEventCandidate[]

  @@unique([showId, name])
  @@map("seasons")
}

/// Whether a season can still be played, or is only an archive.
///
/// Leagues may only be created or joined on UPCOMING and ACTIVE seasons —
/// drafting a cast whose whole season already aired is not a game.
enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

/// A reality TV player available for drafting within a season. Show-specific
/// attributes (hometown, occupation, tribe, ...) live in `metadata` so the
/// column set never has to change per show.
model Contestant {
  id                String   @id @default(cuid())
  seasonId          String
  season            Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name              String
  photoUrl          String?
  /// e.g. { hometown, occupation, age, tribe }
  metadata          Json?
  /// false once evicted / voted out / eliminated
  isActive          Boolean  @default(true)
  /// Final placement once the season resolves (1 = winner)
  placement         Int?
  eliminatedCycleId String?
  eliminatedCycle   Cycle?   @relation("EliminationCycle", fields: [eliminatedCycleId], references: [id])
  createdAt         DateTime @default(now())

  rosterSlots  RosterSlot[]
  scoredEvents ScoredEvent[]
  draftPicks   DraftPick[]
  externalRefs ContestantExternalRef[]
  candidates   IngestedEventCandidate[]

  @@index([seasonId])
  @@map("contestants")
}

/// Maps a contestant to their identifier on an external data source.
///
/// Ingestion matches on this rather than display names: sources routinely use
/// nicknames ("The Lip" for Vince Panaro) and inconsistent legal names, so a
/// stable source-side slug is the only identity worth trusting.
model ContestantExternalRef {
  id           String     @id @default(cuid())
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id], onDelete: Cascade)
  /// e.g. "big-brother-junkies"
  sourceSlug   String
  /// the source's own id for this player, e.g. "ashley-hollis"
  externalId   String
  createdAt    DateTime   @default(now())

  @@unique([sourceSlug, externalId])
  @@unique([contestantId, sourceSlug])
  @@map("contestant_external_refs")
}

/// A weekly or episode-based bounding box used to lock rosters and window
/// scoring events. Named generically since not every show calls this a "week".
model Cycle {
  id        String      @id @default(cuid())
  seasonId  String
  season    Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  label     String
  /// 1-indexed ordering within the season
  sequence  Int
  /// Hard roster lock timestamp
  locksAt   DateTime
  airsAt    DateTime?
  status    CycleStatus @default(UPCOMING)
  createdAt DateTime    @default(now())

  rosterSlots       RosterSlot[]
  scoredEvents      ScoredEvent[]
  teamCycleScores   TeamCycleScore[]
  candidates        IngestedEventCandidate[]
  eliminatedInCycle Contestant[]             @relation("EliminationCycle")

  @@unique([seasonId, sequence])
  @@index([seasonId])
  @@map("cycles")
}

enum CycleStatus {
  UPCOMING
  /// rosters can no longer be edited
  LOCKED
  /// episode airing, events may be recorded
  LIVE
  /// all events recorded and finalized, leaderboard settled
  SCORED
}

// ---------------------------------------------------------------------------
// Multi-tenant league structures (Traditional Fantasy Sport format)
// ---------------------------------------------------------------------------

model League {
  id                String         @id @default(cuid())
  seasonId          String
  season            Season         @relation(fields: [seasonId], references: [id])
  name              String
  inviteCode        String         @unique
  commissionerId    String
  commissioner      User           @relation("LeagueCommissioner", fields: [commissionerId], references: [id])
  isPublic          Boolean        @default(false)
  rosterSize        Int            @default(5)
  maxTeams          Int            @default(12)
  draftType         DraftType      @default(SNAKE)
  scoringRulesetId  String
  scoringRuleset    ScoringRuleset @relation(fields: [scoringRulesetId], references: [id])
  draftStatus       DraftStatus    @default(NOT_STARTED)
  draftStartsAt     DateTime?
  draftCompletedAt  DateTime?
  /// Minutes before Cycle.airsAt that this league's rosters hard-lock. Null
  /// falls back to the season-wide Cycle.locksAt.
  lockOffsetMinutes Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  members    LeagueMember[]
  teams      Team[]
  draftPicks DraftPick[]
  messages   LeagueMessage[]

  @@index([seasonId])
  @@map("leagues")
}

/// The league's trash-talk feed: draft coordination, gloating, condolences.
///
/// Deliberately league-scoped rather than global. The social pull of a fantasy
/// league is the specific group of people in it, and a shared room across
/// leagues would need moderation tooling this app has no business owning yet.
model LeagueMessage {
  id        String    @id @default(cuid())
  leagueId  String
  league    League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  /// Soft delete: an author removing a message should not orphan the replies
  /// and reactions hanging off it, and a commissioner needs to see that
  /// something was removed rather than have it vanish mid-argument.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  reactions LeagueMessageReaction[]

  // The feed is always "newest in this league", so the index leads with
  // leagueId and carries createdAt to serve the ordering too.
  @@index([leagueId, createdAt])
  @@map("league_messages")
}

/// Hype (gold) and Shade (red) — the two things anyone actually wants to say
/// back to a trash-talk post, without opening a full reply thread.
model LeagueMessageReaction {
  id        String        @id @default(cuid())
  messageId String
  message   LeagueMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  kind      ReactionKind
  createdAt DateTime      @default(now())

  // One of each kind per person per message; the constraint is what makes the
  // toggle idempotent under a double-tap.
  @@unique([messageId, userId, kind])
  @@index([messageId])
  @@map("league_message_reactions")
}

enum ReactionKind {
  HYPE
  SHADE
}

enum DraftType {
  SNAKE
  LINEAR
  AUCTION
}

enum DraftStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LeagueMember {
  id       String           @id @default(cuid())
  leagueId String
  league   League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id])
  role     LeagueRole       @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  @@unique([leagueId, userId])
  // "Which leagues am I in" is the app's landing query, and the unique above
  // leads with leagueId so it cannot serve a userId lookup.
  @@index([userId, status])
  @@map("league_members")
}

enum LeagueRole {
  COMMISSIONER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

/// A user's fixed squad within a league for the whole season.
model Team {
  id                 String   @id @default(cuid())
  leagueId           String
  league             League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id])
  name               String
  draftOrderPosition Int?
  createdAt          DateTime @default(now())

  rosterSlots RosterSlot[]
  draftPicks  DraftPick[]
  cycleScores TeamCycleScore[]

  @@unique([leagueId, ownerId])
  @@unique([leagueId, draftOrderPosition])
  @@index([ownerId])
  @@map("teams")
}

/// Assignment of a Contestant to a Team, scoped to a Cycle. Modeled per-cycle
/// so "roster as of cycle N" is always reconstructible and so a league can
/// later allow waiver-style swaps without a migration. The MVP snake draft
/// writes one row per contestant per remaining cycle.
model RosterSlot {
  id           String     @id @default(cuid())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  cycleId      String
  cycle        Cycle      @relation(fields: [cycleId], references: [id])
  acquiredAt   DateTime   @default(now())

  @@unique([teamId, contestantId, cycleId])
  @@index([cycleId])
  @@map("roster_slots")
}

/// Immutable record of the draft. The unique constraints are what actually
/// enforce "no duplicate players exist on rosters" at the database level.
model DraftPick {
  id           String     @id @default(cuid())
  leagueId     String
  league       League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  round        Int
  /// overall pick number across the whole draft, 1-indexed
  pickNumber   Int
  pickedAt     DateTime   @default(now())

  @@unique([leagueId, contestantId])
  @@unique([leagueId, pickNumber])
  @@map("draft_picks")
}

// ---------------------------------------------------------------------------
// Scoring engine: show-agnostic rule dictionary + transactional ledger
// ---------------------------------------------------------------------------

/// A named collection of EventDefinitions a league can select, e.g.
/// "Classic/Measurable" vs "Drama/Social". This is what turns "toggle between
/// rule sets" into a league configuration choice rather than a code branch.
model ScoringRuleset {
  id          String   @id @default(cuid())
  showId      String
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  eventDefinitions ScoringRulesetEventDefinition[]
  leagues          League[]

  @@unique([showId, slug])
  @@map("scoring_rulesets")
}

/// The dynamic rule dictionary: every scorable event for a Show with its point
/// value. Adding a show or rebalancing scoring is a data change here — never a
/// schema change and never a change to the scoring engine.
model EventDefinition {
  id              String        @id @default(cuid())
  showId          String
  show            Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  /// stable machine key, e.g. "HOH_WIN"
  code            String
  label           String
  category        EventCategory
  points          Decimal       @db.Decimal(6, 2)
  /// false for once-per-season awards (placement, jury) so the admin UI and
  /// validation layer can prevent accidental duplicates
  isRepeatable    Boolean       @default(true)
  /// true when the event is expected once per cycle for each surviving
  /// contestant (e.g. "weeks in the house") and can be auto-generated
  isPerCycleAward Boolean       @default(false)
  description     String?
  createdAt       DateTime      @default(now())

  scoringRulesetLinks ScoringRulesetEventDefinition[]
  scoredEvents        ScoredEvent[]

  @@unique([showId, code])
  @@index([showId, category])
  @@map("event_definitions")
}

/// Show-agnostic bucketing so UIs and rule browsers never need to know
/// show-specific category names.
enum EventCategory {
  COMPETITION_GAMEPLAY
  ELIMINATION_ENDGAME
  SOCIAL_DRAMA
}

/// Which EventDefinitions are active — and at what point value — within a
/// given ScoringRuleset. Lets rulesets share EventDefinition rows while
/// enabling different subsets and different point values.
model ScoringRulesetEventDefinition {
  id                String          @id @default(cuid())
  scoringRulesetId  String
  scoringRuleset    ScoringRuleset  @relation(fields: [scoringRulesetId], references: [id], onDelete: Cascade)
  eventDefinitionId String
  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id], onDelete: Cascade)
  pointsOverride    Decimal?        @db.Decimal(6, 2)

  @@unique([scoringRulesetId, eventDefinitionId])
  @@map("scoring_ruleset_event_definitions")
}

/// The transactional ledger: one row per contestant-event-cycle occurrence.
/// Team totals are always derived from this, never stored as the primary fact,
/// which is what makes retroactive audits and corrections safe.
model ScoredEvent {
  id                String          @id @default(cuid())
  contestantId      String
  contestant        Contestant      @relation(fields: [contestantId], references: [id])
  eventDefinitionId String
  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id])
  cycleId           String
  cycle             Cycle           @relation(fields: [cycleId], references: [id])
  /// Snapshot of the point value at recording time, so later rule edits do not
  /// silently rewrite settled history. The engine can re-resolve against the
  /// live ruleset on demand (see `pointsSource` in the scoring engine).
  pointsAwarded     Decimal         @db.Decimal(6, 2)
  /// Free-form context: alliance name, competition name, opposing contestant.
  metadata          Json?
  note              String?
  occurredAt        DateTime        @default(now())
  recordedById      String?
  recordedBy        User?           @relation("EventRecorder", fields: [recordedById], references: [id])
  /// Soft-void for corrections instead of hard delete
  isVoided          Boolean         @default(false)
  voidedReason      String?
  createdAt         DateTime        @default(now())

  audits ScoreAudit[]

  @@index([cycleId, isVoided])
  @@index([contestantId])
  @@map("scored_events")
}

/// Audit trail for retroactive score corrections, so history is appended to
/// rather than mutated in place.
model ScoreAudit {
  id             String      @id @default(cuid())
  scoredEventId  String
  scoredEvent    ScoredEvent @relation(fields: [scoredEventId], references: [id], onDelete: Cascade)
  action         AuditAction
  previousPoints Decimal?    @db.Decimal(6, 2)
  newPoints      Decimal?    @db.Decimal(6, 2)
  reason         String?
  performedById  String
  performedBy    User        @relation(fields: [performedById], references: [id])
  createdAt      DateTime    @default(now())

  @@map("score_audits")
}

enum AuditAction {
  CREATED
  VOIDED
  RESTORED
  POINTS_ADJUSTED
}

// ---------------------------------------------------------------------------
// Derived leaderboard state — written only by the recalculation job
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Ingestion: automated event capture from external data sources
// ---------------------------------------------------------------------------

/// A proposed ScoredEvent parsed from an external source, held here before it
/// becomes real.
///
/// Scrapers misread pages and sites redesign without warning, so parsed results
/// never write straight to the ledger. High-confidence candidates auto-publish
/// immediately; anything ambiguous waits for a human. Either way the candidate
/// row survives as the provenance record for its ScoredEvent.
model IngestedEventCandidate {
  id                String          @id @default(cuid())
  sourceSlug        String
  /// Stable per-source identity for this exact fact, e.g.
  /// "big-brother-27:w3:HOH_WIN:morgan-pope". Re-syncing the same page must not
  /// create duplicates, so this is the upsert key.
  sourceRef         String
  sourceUrl         String?
  seasonId          String
  season            Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /// Null when the source's week could not be matched to a Cycle.
  cycleId           String?
  cycle             Cycle?          @relation(fields: [cycleId], references: [id])
  /// Null when the source's player could not be matched to a Contestant.
  contestantId      String?
  contestant        Contestant?     @relation(fields: [contestantId], references: [id])
  /// EventDefinition.code this maps to, resolved at publish time.
  eventCode         String
  /// What the source actually said, kept verbatim so a reviewer can judge a
  /// bad parse without re-fetching the page.
  rawPlayerName     String
  rawPlayerRef      String
  rawWeekLabel      String
  confidence        Confidence
  /// Why confidence was downgraded; empty for clean HIGH matches.
  confidenceReasons String[]
  status            CandidateStatus @default(PENDING)
  scoredEventId     String?
  reviewedById      String?
  reviewedBy        User?           @relation("CandidateReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([sourceSlug, sourceRef])
  @@index([seasonId, status])
  @@map("ingested_event_candidates")
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum CandidateStatus {
  /// Awaiting human review
  PENDING
  /// Published automatically on a HIGH-confidence match
  AUTO_PUBLISHED
  /// Published by a reviewer
  PUBLISHED
  REJECTED
}

/// One execution of an ingestion sync.
///
/// Exists so silent breakage is detectable: a run that parses zero weeks off a
/// page that should have them is a failure even though nothing threw.
model IngestionRun {
  id            String    @id @default(cuid())
  sourceSlug    String
  seasonId      String?
  status        RunStatus @default(RUNNING)
  weeksParsed   Int       @default(0)
  candidatesNew Int       @default(0)
  autoPublished Int       @default(0)
  pendingReview Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([sourceSlug, startedAt])
  @@map("ingestion_runs")
}

enum RunStatus {
  RUNNING
  SUCCESS
  /// Completed but produced nothing usable — treat as a parser health alarm.
  EMPTY
  FAILED
}

model TeamCycleScore {
  id               String   @id @default(cuid())
  teamId           String
  team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cycleId          String
  cycle            Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cyclePoints      Decimal  @db.Decimal(8, 2)
  cumulativePoints Decimal  @db.Decimal(8, 2)
  rank             Int?
  computedAt       DateTime @default(now())

  @@unique([teamId, cycleId])
  @@index([cycleId])
  @@map("team_cycle_scores")
}

/// One manager's final line from a league that no longer exists.
///
/// Deleting a league cascades through its teams, rosters, picks and
/// materialized scores, and that is right for the league — nothing about it
/// should linger. It is wrong for the people who played in it: the points a
/// manager scored are theirs, and the career view, the lifetime total and the
/// badges built on it must not lose a season because a commissioner closed
/// the league afterwards. So `deleteLeague` writes one of these per team that
/// had scored anything, in the same transaction as the delete.
///
/// Like `Notification`, the row carries its own copy of every name it needs
/// and holds no relation to the league or the season, so it survives the
/// thing it describes.
model CareerRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Plain ids, not relations: a handle for dedupe and support, never a dependency.
  leagueId String
  seasonId String

  leagueName String
  teamName   String
  seasonName String
  showName   String

  /// Cumulative points at the last cycle that had actually been played.
  totalPoints     Decimal @db.Decimal(8, 2)
  /// Standing at that same cycle; null when nothing had been scored yet.
  finalRank       Int?
  teamCount       Int
  /// Whether the season had finished when the league closed. A first place
  /// in a season still running is a lead, not a title.
  seasonCompleted Boolean
  /// The week-by-week line the career chart draws:
  /// `[{ label, sequence, cyclePoints, cumulativePoints, rank }]`.
  history         Json

  archivedAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
  @@map("career_records")
}
