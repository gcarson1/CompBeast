// Comp Beast — Pluggable Domain Model
//
// Design principle: the platform core (League/Team/Roster/User) and the
// scoring core (EventDefinition/ScoredEvent) never reference show-specific
// concepts directly. Everything that varies by show (Big Brother, Survivor,
// The Traitors, ...) lives behind Show/Season/Contestant/EventDefinition,
// which are just rows — adding a new show is a seed script, not a schema
// change or a code change to the scoring engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform: identity & multi-tenancy
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaguesOwned   League[]       @relation("LeagueCommissioner")
  memberships    LeagueMember[]
  teams          Team[]
  auditedActions ScoreAudit[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Show-agnostic program containers
// ---------------------------------------------------------------------------

// A reality program franchise, e.g. "Big Brother", "Survivor", "The Traitors".
model Show {
  id        String   @id @default(cuid())
  slug      String   @unique // "big-brother"
  name      String
  format    ShowFormat @default(TRADITIONAL_FANTASY_SPORT)
  createdAt DateTime @default(now())

  seasons          Season[]
  eventDefinitions EventDefinition[]

  @@map("shows")
}

// The kind of fantasy competition this show is played as. MVP only
// implements TRADITIONAL_FANTASY_SPORT (fixed squads, weekly cycles,
// leaderboard) but the enum lets future formats (e.g. draft-and-hold,
// survivor pools) be added without new tables.
enum ShowFormat {
  TRADITIONAL_FANTASY_SPORT
}

// A single airing season/series of a Show, e.g. "Big Brother 27".
model Season {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  name      String
  year      Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())

  contestants Contestant[]
  cycles      Cycle[]
  leagues     League[]

  @@unique([showId, name])
  @@map("seasons")
}

// A reality TV player available for drafting within a season. Show-specific
// attributes (age, hometown, occupation, etc.) live in `metadata` so the
// column set never has to change per show.
model Contestant {
  id         String   @id @default(cuid())
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  name       String
  photoUrl   String?
  metadata   Json?    // e.g. { hometown, occupation, age }
  isActive   Boolean  @default(true) // false once evicted/voted out/eliminated
  eliminatedCycleId String?
  eliminatedCycle   Cycle? @relation("EliminationCycle", fields: [eliminatedCycleId], references: [id])
  createdAt  DateTime @default(now())

  rosterSlots  RosterSlot[]
  scoredEvents ScoredEvent[]
  draftPicks   DraftPick[]

  @@index([seasonId])
  @@map("contestants")
}

// A weekly or episode-based bounding box used to lock rosters and window
// scoring events. Naming is generic ("Cycle") since not every show calls
// this a "week" — Survivor might call it an "episode", Traitors a "round".
model Cycle {
  id            String    @id @default(cuid())
  seasonId      String
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  label         String    // "Week 1", "Episode 3"
  sequence      Int       // ordering, 1-indexed
  locksAt       DateTime  // roster lock timestamp, configurable per league via League.lockOffsetMinutes if needed
  airsAt        DateTime?
  status        CycleStatus @default(UPCOMING)
  createdAt     DateTime  @default(now())

  rosterSlots       RosterSlot[]
  scoredEvents      ScoredEvent[]
  eliminatedInCycle Contestant[] @relation("EliminationCycle")

  @@unique([seasonId, sequence])
  @@index([seasonId])
  @@map("cycles")
}

enum CycleStatus {
  UPCOMING
  LOCKED   // rosters can no longer be edited
  LIVE     // episode airing, events may be recorded
  SCORED   // all events recorded and finalized, leaderboard settled
}

// ---------------------------------------------------------------------------
// Multi-tenant league structures (Traditional Fantasy Sport format)
// ---------------------------------------------------------------------------

model League {
  id                String   @id @default(cuid())
  seasonId          String
  season            Season   @relation(fields: [seasonId], references: [id])
  name              String
  commissionerId    String
  commissioner      User     @relation("LeagueCommissioner", fields: [commissionerId], references: [id])
  isPublic          Boolean  @default(false)
  rosterSize        Int      @default(5)
  draftType         DraftType @default(SNAKE)
  scoringRulesetId  String
  scoringRuleset    ScoringRuleset @relation(fields: [scoringRulesetId], references: [id])
  draftStatus       DraftStatus @default(NOT_STARTED)
  draftStartedAt    DateTime?
  draftCompletedAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members    LeagueMember[]
  teams      Team[]
  draftPicks DraftPick[]

  @@index([seasonId])
  @@map("leagues")
}

enum DraftType {
  SNAKE
  LINEAR
  AUCTION
}

enum DraftStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     LeagueRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@map("league_members")
}

enum LeagueRole {
  COMMISSIONER
  ADMIN
  MEMBER
}

// A user's fixed squad within a league for the whole season.
model Team {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User     @relation(fields: [ownerId], references: [id])
  name     String
  draftOrderPosition Int?
  createdAt DateTime @default(now())

  rosterSlots RosterSlot[]
  draftPicks  DraftPick[]
  cycleScores TeamCycleScore[]

  @@unique([leagueId, ownerId])
  @@map("teams")
}

// The (season-long, fixed) assignment of a Contestant to a Team. Modeled
// per-cycle so a "current roster as of cycle N" can be reconstructed even if
// a league later allows waiver-style swaps — MVP just inserts one row per
// contestant at draft time, all cycles.
model RosterSlot {
  id           String     @id @default(cuid())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  cycleId      String
  cycle        Cycle      @relation(fields: [cycleId], references: [id])
  acquiredAt   DateTime   @default(now())

  @@unique([teamId, contestantId, cycleId])
  @@index([cycleId])
  @@map("roster_slots")
}

// Immutable record of the draft, used to enforce no-duplicate-picks and to
// reconstruct draft history/order.
model DraftPick {
  id           String     @id @default(cuid())
  leagueId     String
  league       League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])
  contestantId String
  contestant   Contestant @relation(fields: [contestantId], references: [id])
  round        Int
  pickNumber   Int // overall pick number across the whole draft
  pickedAt     DateTime   @default(now())

  @@unique([leagueId, contestantId]) // enforces no duplicate players across the league
  @@unique([leagueId, pickNumber])
  @@map("draft_picks")
}

// ---------------------------------------------------------------------------
// Scoring engine: show-agnostic rule dictionary + transactional ledger
// ---------------------------------------------------------------------------

// A named, versioned collection of EventDefinitions a league can select,
// e.g. "Big Brother — Classic/Measurable" vs "Big Brother — Drama/Social".
// This is what makes the "toggle between rule sets" requirement a league
// configuration choice rather than a code branch.
model ScoringRuleset {
  id          String   @id @default(cuid())
  showId      String
  show        Show     @relation(fields: [showId], references: [id])
  slug        String   // "classic-measurable" | "drama-social" | league can compose a custom one
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  eventDefinitions ScoringRulesetEventDefinition[]
  leagues          League[]

  @@unique([showId, slug])
  @@map("scoring_rulesets")
}

// The dynamic rule dictionary: every scorable event for a Show, with its
// point value. Adding a new show or rebalancing a show's scoring is a data
// change here, never a schema or scoring-engine code change.
model EventDefinition {
  id          String   @id @default(cuid())
  showId      String
  show        Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  code        String   // stable machine key, e.g. "HOH_WIN", "EVICTED_UNANIMOUS"
  label       String   // human-readable, e.g. "Win HOH"
  category    EventCategory
  points      Decimal  @db.Decimal(6, 2)
  isPerOccurrence Boolean @default(true) // e.g. "weeks survived" awards points each cycle it recurs
  description String?
  createdAt   DateTime @default(now())

  scoringRulesetLinks ScoringRulesetEventDefinition[]
  scoredEvents        ScoredEvent[]

  @@unique([showId, code])
  @@index([showId, category])
  @@map("event_definitions")
}

// Show-agnostic bucketing so UIs and rule browsers don't need to know
// show-specific category names.
enum EventCategory {
  COMPETITION_GAMEPLAY
  ELIMINATION_ENDGAME
  SOCIAL_DRAMA
}

// Join table: which EventDefinitions are active (and at what point value
// override, if any) within a given ScoringRuleset. Lets "Classic" and
// "Drama" rulesets share the same EventDefinition rows while enabling
// different subsets, and lets a league override a point value without
// forking the base definition.
model ScoringRulesetEventDefinition {
  id                String   @id @default(cuid())
  scoringRulesetId  String
  scoringRuleset    ScoringRuleset  @relation(fields: [scoringRulesetId], references: [id], onDelete: Cascade)
  eventDefinitionId String
  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id], onDelete: Cascade)
  pointsOverride    Decimal? @db.Decimal(6, 2)

  @@unique([scoringRulesetId, eventDefinitionId])
  @@map("scoring_ruleset_event_definitions")
}

// The transactional ledger: one row per contestant-event-cycle occurrence.
// This is the single source of truth the scoring engine aggregates from —
// team totals are always derived, never stored as the primary fact, which
// is what makes retroactive audits/corrections safe (see ScoreAudit).
model ScoredEvent {
  id                String   @id @default(cuid())
  contestantId      String
  contestant        Contestant @relation(fields: [contestantId], references: [id])
  eventDefinitionId String
  eventDefinition   EventDefinition @relation(fields: [eventDefinitionId], references: [id])
  cycleId           String
  cycle             Cycle    @relation(fields: [cycleId], references: [id])
  pointsAwarded     Decimal  @db.Decimal(6, 2) // snapshot of points at time of recording (survives later rule edits)
  occurredAt        DateTime @default(now())
  recordedById      String?  // admin/User.id who recorded it
  isVoided          Boolean  @default(false) // soft-void for corrections instead of hard delete
  voidedReason      String?
  createdAt         DateTime @default(now())

  audits ScoreAudit[]

  @@index([cycleId])
  @@index([contestantId])
  @@map("scored_events")
}

// Audit trail for retroactive score corrections (a ScoredEvent voided,
// re-added, or point-adjusted after initial recording), satisfying the
// "retroactive score corrections if game events are audited" requirement
// without mutating history in place.
model ScoreAudit {
  id            String   @id @default(cuid())
  scoredEventId String
  scoredEvent   ScoredEvent @relation(fields: [scoredEventId], references: [id], onDelete: Cascade)
  action        AuditAction
  previousPoints Decimal? @db.Decimal(6, 2)
  newPoints      Decimal? @db.Decimal(6, 2)
  reason        String?
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@map("score_audits")
}

enum AuditAction {
  CREATED
  VOIDED
  RESTORED
  POINTS_ADJUSTED
}

// ---------------------------------------------------------------------------
// Derived/materialized leaderboard state (recomputed by the score
// distribution job — see roadmap Step 2/4 — never hand-edited)
// ---------------------------------------------------------------------------

model TeamCycleScore {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  cycleId   String
  cyclePoints   Decimal @db.Decimal(8, 2)
  cumulativePoints Decimal @db.Decimal(8, 2)
  rank      Int?
  computedAt DateTime @default(now())

  @@unique([teamId, cycleId])
  @@index([cycleId])
  @@map("team_cycle_scores")
}
