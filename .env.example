# Homebrew Postgres on macOS has no password and uses your macOS username:
#   brew services start postgresql@16 && createdb compbeast
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/compbeast?schema=public"

# Comma-separated emails granted platform admin on first sign-in.
# Needed to reach /admin/ingestion after a fresh database.
PLATFORM_ADMIN_EMAILS="you@example.com"
