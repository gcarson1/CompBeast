# Homebrew Postgres on macOS has no password and uses your macOS username:
#   brew services start postgresql@16 && createdb compbeast
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/compbeast?schema=public"

# Clerk. Required — there is no development bypass, so every page that asks
# who you are fails without these. Both come from a Clerk application's
# API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Comma-separated emails granted platform admin. Reconciled on every sign-in,
# not just the first, so adding an address here promotes an account that
# already exists the next time it signs in.
# Needed to reach /admin/ingestion.
PLATFORM_ADMIN_EMAILS="you@example.com"

# Optional. Where the runtime connects. When this is a pooled
# `prisma+postgres://` URL the app uses it for every query and leaves
# DATABASE_URL to the Prisma CLI for migrations, which is what keeps a burst of
# serverless functions from exhausting the database's direct connection limit.
# On a plain postgres:// URL the app instead caps itself at one connection per
# function instance. Check which one is live at /api/admin/db-health.
PRISMA_DATABASE_URL=""

# Email alerts. Without a key the app behaves exactly as it did before emails
# existed: notifications still appear in-app, nothing is sent, and the settings
# on /account say so.
#
# RESEND_API_KEY comes from https://resend.com/api-keys.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend. Left unset, the app falls
# back to Resend's shared sandbox sender, which only delivers to the address
# that owns the Resend account — fine for testing, useless for a league.
EMAIL_FROM="Comp Beast <alerts@your-domain.com>"
# The origin email links point at. On Vercel this is inferred from the project's
# production domain; set it explicitly for a custom domain.
NEXT_PUBLIC_APP_URL=""

# Optional. Live X content for the "Latest buzz" panel, via the v2 recent
# search endpoint. Without it the panel falls back to RSS (the show's own
# community site, then Google News) — see src/lib/social-feed/.
#
# There is no free tier that returns search results, so this needs a paid X
# API plan. Set it and X becomes the primary source with no code change.
X_BEARER_TOKEN=""

# Optional. Vercel signs its cron requests to /api/cron/sync with this as a
# bearer token. Without it the daily sync route refuses every request, so the
# schedule in vercel.json is inert until it is set. Any long random string:
#   openssl rand -hex 32
CRON_SECRET=""

# Optional. Web Push. One key pair per deployment:
#   npx web-push generate-vapid-keys
# Without both keys nothing is sent and the switch on /account is hidden.
# VAPID_SUBJECT is a mailto: or https: contact the push services can reach
# you at; it defaults to the production origin.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Optional. Sentry error reporting, errors only (no tracing, no replay).
# Inert without the DSN; the browser SDK is loaded late so it never sits on
# the first paint. The other three are build-time only and enable source-map
# upload from the Vercel build — leave them unset to skip the upload.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
