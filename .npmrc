# @vercel/analytics and @vercel/speed-insights declare *optional* peers for
# every framework they support (SvelteKit, Vue, Nuxt, Remix...). npm 11
# resolves those trees anyway and fails on SvelteKit's Vite 8 against the
# Vite 5 that Vitest 2 needs — none of which this Next.js app installs.
# Legacy peer handling installs what package.json asks for and nothing else.
legacy-peer-deps=true
